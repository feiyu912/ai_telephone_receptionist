# ===========================================
# POD6 AI Voice Agent - Environment Variables
# ===========================================

# --- Supabase / PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres.yourproject:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cartesia (STT + TTS) ---
CARTESIA_API_KEY=your-cartesia-api-key

# --- Microsoft Graph (Outlook Calendar booking + email sending) ---
# Same Azure app handles both. Permissions: Calendars.ReadWrite, Mail.Send, User.Read.All
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_CALENDAR_EMAIL=calendar-owner@yourcompany.com
MS_SENDER_EMAIL=AIVoiceAgent@yourcompany.com

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=your-hubspot-token
SMTP_FROM=

# --- Server ---
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-app.onrender.com
DASHBOARD_URL=https://your-dashboard.example.com
CORS_ORIGINS=https://your-dashboard.example.com,http://localhost:3000
LOG_LEVEL=info
COOKIE_SECURE=true
AUTH_SECRET=change-me-to-a-long-random-secret

# Dashboard users live in the `dashboard_users` table in Supabase.
# Seed with `python scripts/seed_dashboard_users.py`.
