    {
      "parameters": {
        "jsCode": "// Build SQL from input parameters\nconst input = $json;\nconst phone = (input.phone || '').replace(/'/g, \"''\");\nconst event_type = (input.event_type || '').replace(/'/g, \"''\");\nconst channel = (input.channel || '').replace(/'/g, \"''\");\nconst summary = (input.summary || '').replace(/'/g, \"''\");\n\nconst sql = `INSERT INTO analytics_events (event_type, channel, customer_phone, event_data)\nVALUES ('$${event_type}', '$${channel}', '$${phone}', json_build_object('summary', '$${summary}')::jsonb)`;\nreturn [{ json: { sql } }];\n"
      },
      "type": "n8n-nodes-base.code",
