        "jsCode": "const phone = ($json.phone || '').replace(/'/g, \"''\");\n\nconst sql = \\`INSERT INTO caller_consent (caller_phone, forget_requested, forget_requested_at)\nVALUES ('\\${phone}', TRUE, NOW())\nON CONFLICT (caller_phone) DO UPDATE SET forget_requested = TRUE, forget_requested_at = NOW();\nDELETE FROM caller_memory WHERE caller_phone = '\\${phone}'\\`;\n\nreturn [{ json: { sql } }];"
