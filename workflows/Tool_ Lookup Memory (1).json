    {
      "parameters": {
        "jsCode": "// Build SQL from input parameters\nconst input = $json;\nconst phone = (input.phone || '').replace(/'/g, \"''\");\n\nconst sql = `SELECT memory_key, memory_value, privacy_tier FROM caller_memory\nWHERE caller_phone = '$${phone}'\nAND (expires_at IS NULL OR expires_at > NOW())\nAND caller_phone NOT IN (\n  SELECT caller_phone FROM caller_consent\n  WHERE forget_requested = TRUE AND forget_completed_at IS NULL\n)`;\nreturn [{ json: { sql } }];\n"
      },
      "type": "n8n-nodes-base.code",
