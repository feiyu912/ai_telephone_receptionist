      "parameters": {
        "jsCode": "const d = $('Route Decision').first().json;\nconst customer = $json || {};\nconst customerName = customer.name || '';\nconst tier = customer.tier || 'starter';\n\nreturn [{ json: {\n  chatInput: d.messageBody,\n  phone: d.phone,\n  sendTo: d.sendTo,\n  sendFrom: d.sendFrom,\n  messageSid: d.messageSid,\n  profileName: d.profileName,\n  customerName,\n  tier,\n  channel: 'whatsapp'\n} }];"
