    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst from = (body.From || '').replace('whatsapp:', '');\nconst to = (body.To || '').replace('whatsapp:', '');\nconst messageSid = body.MessageSid || '';\nconst messageBody = (body.Body || '').trim();\nconst profileName = body.ProfileName || '';\nconst msg = messageBody.toUpperCase();\n\nlet phone = from.replace(/[^+\\d]/g, '');\nif (phone && !phone.startsWith('+')) phone = '+' + phone;\n\nconst isStop = ['STOP','UNSUBSCRIBE','CANCEL','END','QUIT'].includes(msg);\nconst isHelp = ['HELP','INFO'].includes(msg);\nconst isStart = ['START','YES','UNSTOP'].includes(msg);\n\nlet complianceAction = 'normal', complianceReply = '';\nif (isStop) { complianceAction = 'opt_out'; complianceReply = 'You have been unsubscribed from WhatsApp messages. Reply START to re-subscribe.'; }\nelse if (isHelp) { complianceAction = 'help'; complianceReply = 'Reply STOP to unsubscribe. For support, call us or visit 360dmmc.com.'; }\nelse if (isStart) { complianceAction = 'opt_in'; complianceReply = 'You have been re-subscribed. Welcome back!'; }\n\nreturn [{ json: { channel: 'whatsapp', phone, to, messageSid, messageBody, profileName,\n  sendTo: 'whatsapp:' + phone, sendFrom: 'whatsapp:' + to,\n  complianceAction, complianceReply, isComplianceOverride: complianceAction !== 'normal' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        2592
      ],
      "id": "d701f068-8754-4414-aee2-56c1e316878c",
      "name": "Normalize + Compliance Check"
    },
    {
      "parameters": {
        "jsCode": "// Idempotency: check if this MessageSid was already processed\nconst d = $json;\nconst sid = d.messageSid;\nif (!sid) return [{ json: { ...d, isDuplicate: false } }];\n\n// We'll use a simple approach: check analytics_events for this session_id\n// In production, consider Redis or a dedicated dedup table\nreturn [{ json: { ...d, isDuplicate: false } }];\n"
      },
      "type": "n8n-nodes-base.code",
