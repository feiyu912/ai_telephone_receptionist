      "parameters": {
        "jsCode": "const d = $('Normalize + Compliance Check').first().json;\nconst optOutRow = $json;\nconst isOptedOut = optOutRow && optOutRow.id;\n\nif (isOptedOut && d.complianceAction !== 'opt_in') {\n  return [{ json: { ...d, finalAction: 'blocked' } }];\n}\nif (d.isComplianceOverride) {\n  return [{ json: { ...d, finalAction: d.complianceAction } }];\n}\nreturn [{ json: { ...d, finalAction: 'agent' } }];\n"
