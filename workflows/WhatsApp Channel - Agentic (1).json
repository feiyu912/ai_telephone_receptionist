      "parameters": {
        "jsCode": "const d = $json;\nconst action = d.finalAction;\nlet sql = '';\nif (action === 'opt_out') {\n  sql = \"INSERT INTO opt_outs (phone, channel, opted_out_at) VALUES ('\" + d.phone + \"', 'whatsapp', NOW()) ON CONFLICT DO NOTHING;\";\n} else if (action === 'opt_in') {\n  sql = \"DELETE FROM opt_outs WHERE phone = '\" + d.phone + \"' AND channel = 'whatsapp';\";\n}\nreturn [{ json: { ...d, complianceSql: sql } }];"
