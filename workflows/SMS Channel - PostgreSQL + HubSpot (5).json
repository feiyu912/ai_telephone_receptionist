          "name": "OpenAi account POD2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// === BUILD SMS CALLER MEMORY UPSERTS ===\nconst initData = $('Initialize Memory').first().json;\nconst callerPhone = initData.sender || '';\n\nif (!callerPhone) {\n  return [{ json: { skip: true, reason: 'no caller phone' } }];\n}\n\nlet facts = {};\nconst raw = $json?.choices?.[0]?.message?.content\n  || $json?.message?.content || '{}';\n\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  facts = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { skip: true, reason: 'parse error', raw: raw } }];\n}\n\nif (Object.keys(facts).length === 0) {\n  return [{ json: { skip: true, reason: 'no facts extracted' } }];\n}\n\nconst SAFE_KEYS = ['has_called_before','preferred_language','service_interest',\n  'communication_preference','call_count','last_topic','sentiment',\n  'callback_requested','channel_preference','preferred_contact_time','timezone',\n  'interest','role','company'];\n\nconst expiryDate = new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString();\n\nconst values = Object.entries(facts)\n  .filter(([k, v]) => v && String(v).trim())\n  .map(([k, v]) => {\n    const safeKey = String(k).replace(/'/g, \"''\").slice(0, 50);\n    const safeVal = String(v).replace(/'/g, \"''\").slice(0, 500);\n    const tier = SAFE_KEYS.includes(k) ? 'safe' : 'protected';\n    return \"('\" + callerPhone.replace(/'/g, \"''\") + \"', '\" +\n      safeKey + \"', '\" + safeVal + \"', 'sms', '\" +\n      tier + \"', '\" + expiryDate + \"', NOW(), NOW())\";\n  });\n\nif (values.length === 0) {\n  return [{ json: { skip: true, reason: 'no valid facts' } }];\n}\n\nconst query = 'INSERT INTO caller_memory (caller_phone, memory_key, memory_value, source_channel, privacy_tier, expires_at, created_at, updated_at) VALUES ' +\n  values.join(',\\n') +\n  ' ON CONFLICT (caller_phone, memory_key) DO UPDATE SET ' +\n  'memory_value = EXCLUDED.memory_value, privacy_tier = EXCLUDED.privacy_tier, ' +\n  'source_channel = EXCLUDED.source_channel, expires_at = EXCLUDED.expires_at, updated_at = NOW();';\n\nreturn [{ json: { query: query, factCount: values.length, callerPhone: callerPhone, skip: false } }];\n"
      },
