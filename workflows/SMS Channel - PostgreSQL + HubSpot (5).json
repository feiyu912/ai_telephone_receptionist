    {
      "parameters": {
        "jsCode": "// === NORMALIZE TWILIO SMS PAYLOAD ===\nconst body = $json.body || $json;\n\nconst phone = body.From || '';\nconst to = body.To || '';\nconst message = body.Body || '';\nconst messageSid = body.MessageSid || body.SmsSid || '';\nconst numMedia = parseInt(body.NumMedia || '0');\n\nconst mediaUrls = [];\nfor (let i = 0; i < numMedia; i++) {\n  const url = body['MediaUrl' + i];\n  if (url) mediaUrls.push(url);\n}\n\nconst crypto = require('crypto');\nconst idempotencyKey = crypto\n  .createHash('sha256')\n  .update('sms|' + phone + '|' + messageSid + '|' + message.slice(0, 50))\n  .digest('hex')\n  .slice(0, 32);\n\nreturn [{\n  json: {\n    idempotency_key: idempotencyKey,\n    channel: 'sms',\n    sender: phone,\n    recipient: to,\n    message: message,\n    media_urls: mediaUrls,\n    timestamp: new Date().toISOString(),\n    session_id: messageSid,\n    metadata: {\n      twilio_sid: messageSid,\n      num_media: numMedia,\n      from_city: body.FromCity || '',\n      from_state: body.FromState || ''\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3872,
        1488
      ],
      "id": "fc54c5df-4e8e-44a0-8f0f-cff6a47c4de8",
      "name": "Normalize Payload"
    },
    {
      "parameters": {
        "jsCode": "// === IDEMPOTENCY CHECK ===\nconst store = $getWorkflowStaticData('global');\nconst key = $json.idempotency_key;\nconst now = Date.now();\n\nif (!store.processedMessages) store.processedMessages = {};\n\nconst CACHE_TTL = 5 * 60 * 1000;\nfor (const k of Object.keys(store.processedMessages)) {\n  if (now - store.processedMessages[k] > CACHE_TTL) {\n    delete store.processedMessages[k];\n  }\n}\n\nif (store.processedMessages[key]) {\n  return [{ json: { ...$json, is_duplicate: true } }];\n}\n\nstore.processedMessages[key] = now;\nreturn [{ json: { ...$json, is_duplicate: false } }];"
      },
