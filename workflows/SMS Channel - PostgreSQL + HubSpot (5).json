    {
      "parameters": {
        "jsCode": "// === INITIALIZE SMS MEMORY ===\nconst store = $getWorkflowStaticData('global');\nconst prevData = $('Compliance Guardrails').first().json;\nconst phone = prevData.sender || '';\nconst message = prevData.message;\n\nconst customerResults = $('Lookup Customer').all();\nconst customer = customerResults.length > 0 ? customerResults[0].json : {};\n\nif (!store.smsConversations) store.smsConversations = {};\n\nif (!store.smsConversations[phone]) {\n  store.smsConversations[phone] = {\n    history: [],\n    startTime: new Date().toISOString(),\n    customer_id: customer.customer_id || null,\n    customer_name: customer.name || 'Guest',\n    tier: customer.tier || 'starter'\n  };\n}\n\nif (message && message.trim()) {\n  store.smsConversations[phone].history.push({\n    role: 'user',\n    content: message.trim(),\n    timestamp: new Date().toISOString()\n  });\n}\n\nconst MAX_TURNS = 10;\nif (store.smsConversations[phone].history.length > MAX_TURNS) {\n  store.smsConversations[phone].history = \n    store.smsConversations[phone].history.slice(-MAX_TURNS);\n}\n\nconst historyForPrompt = store.smsConversations[phone].history\n  .slice(0, -1)\n  .map(turn => turn.role.toUpperCase() + ': ' + turn.content)\n  .join('\\n');\n\n// --- LONG-TERM: Load caller facts from caller_memory ---\nconst memoryRows = $('Load SMS Caller Memory').all() || [];\nlet callerContext = '';\n\nconst facts = memoryRows\n  .filter(r => r.json && r.json.memory_key && r.json.memory_value)\n  .map(r => `${r.json.memory_key}: ${r.json.memory_value}`);\n\nif (facts.length > 0) {\n  callerContext = 'Known info about this person:\\n' + facts.join('\\n');\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    customer_id: customer.customer_id || null,\n    customer_name: customer.name || 'Guest',\n    tier: customer.tier || 'starter',\n    historyForPrompt: historyForPrompt || 'New conversation.',\n    callerContext: callerContext,\n    conversationHistory: store.smsConversations[phone].history\n  }\n}];"
      },
