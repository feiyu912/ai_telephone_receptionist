    {
      "parameters": {
        "jsCode": "// === COMPLIANCE GUARDRAILS ===\nconst CONFIG = {\n  quietHours: {\n    enabled: true,\n    timezone: 'America/Chicago',\n    startHour: 21,\n    endHour: 8,\n    quietDays: [0, 6],\n  },\n  keywords: {\n    stop: ['stop', 'unsubscribe', 'cancel', 'opt out', 'opt-out', 'quit'],\n    help: ['help', 'info'],\n    start: ['start', 'subscribe', 'yes', 'unstop']\n  },\n  templates: {\n    stop: \"You've been unsubscribed from YourCompany messages. Reply START to resubscribe.\",\n    help: \"YourCompany Help: Reply STOP to unsubscribe. For support, visit 360dmmc.com or call us.\",\n    quietHours: null,\n    alreadyOptedOut: \"You are already unsubscribed. Reply START to resubscribe.\"\n  },\n  piiPatterns: [\n    { name: 'ssn', pattern: /\\b\\d{3}[-\\s]?\\d{2}[-\\s]?\\d{4}\\b/g, replacement: '[SSN REDACTED]' },\n    { name: 'credit_card', pattern: /\\b\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}\\b/g, replacement: '[CARD REDACTED]' },\n  ],\n};\n\nfunction isQuietHours(config) {\n  if (!config.enabled) return false;\n  const now = new Date();\n  const options = { timeZone: config.timezone, hour: 'numeric', weekday: 'short' };\n  const formatter = new Intl.DateTimeFormat('en-US', options);\n  const parts = formatter.formatToParts(now);\n  const hour = parseInt(parts.find(p => p.type === 'hour').value);\n  const dayName = parts.find(p => p.type === 'weekday').value;\n  const dayMap = { 'Sun': 0, 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6 };\n  const dayNum = dayMap[dayName];\n  \n  if (config.quietDays.includes(dayNum)) return true;\n  if (config.startHour > config.endHour) {\n    return hour >= config.startHour || hour < config.endHour;\n  }\n  return hour >= config.startHour && hour < config.endHour;\n}\n\nfunction checkKeywords(message, keywords) {\n  const lower = message.toLowerCase().trim();\n  for (const kw of keywords.stop) {\n    if (lower === kw || lower.startsWith(kw + ' ')) return { type: 'stop', matched: kw };\n  }\n  for (const kw of keywords.start) {\n    if (lower === kw || lower.startsWith(kw + ' ')) return { type: 'start', matched: kw };\n  }\n  for (const kw of keywords.help) {\n    if (lower === kw || lower.startsWith(kw + ' ')) return { type: 'help', matched: kw };\n  }\n  return null;\n}\n\nfunction maskPII(text, patterns) {\n  let masked = text;\n  const found = [];\n  for (const { name, pattern, replacement } of patterns) {\n    const matches = masked.match(pattern);\n    if (matches) {\n      found.push({ type: name, count: matches.length });\n      masked = masked.replace(pattern, replacement);\n    }\n  }\n  return { masked, piiFound: found };\n}\n\nconst prevData = $('Idempotency Check').first().json;\nconst phone = prevData.sender || '';\nconst message = prevData.message || '';\nconst channel = prevData.channel || 'sms';\n\nconst optOutRecords = $('Check Opt-Out DB').all();\nconst isAlreadyOptedOut = optOutRecords.length > 0 && optOutRecords.some(r => r.json.phone);\n\nconst result = {\n  allowed: true,\n  reason: null,\n  response_override: null,\n  masked_message: message,\n  opt_out_action: null,\n  is_resubscribe: false\n};\n\nconst keywordMatch = checkKeywords(message, CONFIG.keywords);\n\nif (keywordMatch) {\n  if (keywordMatch.type === 'stop') {\n    result.allowed = false;\n    result.reason = 'opt_out';\n    if (isAlreadyOptedOut) {\n      result.response_override = CONFIG.templates.alreadyOptedOut;\n    } else {\n      result.response_override = CONFIG.templates.stop;\n      result.opt_out_action = 'add';\n    }\n  } else if (keywordMatch.type === 'start') {\n    if (isAlreadyOptedOut) {\n      result.opt_out_action = 'remove';\n      result.is_resubscribe = true;\n      result.response_override = \"Welcome back! You're now subscribed to YourCompany messages.\";\n      result.allowed = false;\n      result.reason = 'resubscribe';\n    }\n  } else if (keywordMatch.type === 'help') {\n    result.allowed = false;\n    result.reason = 'help_request';\n    result.response_override = CONFIG.templates.help;\n  }\n}\n\nif (result.allowed && isAlreadyOptedOut) {\n  result.allowed = false;\n  result.reason = 'opted_out';\n  result.response_override = null;\n}\n\nif (result.allowed && isQuietHours(CONFIG.quietHours)) {\n  result.allowed = false;\n  result.reason = 'quiet_hours';\n  result.response_override = CONFIG.templates.quietHours;\n}\n\nconst { masked, piiFound } = maskPII(message, CONFIG.piiPatterns);\nresult.masked_message = masked;\n\nreturn [{\n  json: {\n    ...prevData,\n    compliance: result,\n    allowed: result.allowed,\n    blocked_reason: result.reason,\n    response_override: result.response_override,\n    masked_message: result.masked_message,\n    opt_out_action: result.opt_out_action,\n    is_resubscribe: result.is_resubscribe\n  }\n}];"
      },
