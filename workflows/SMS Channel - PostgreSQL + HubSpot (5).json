        "messages": {
          "values": [
            {
              "content": "You extract key facts about a person from an SMS conversation. Return ONLY a valid JSON object with facts you can identify.\n\nAvailable keys:\n- name: person's name (even first name only)\n- company: their company or organization\n- role: job title or role\n- interest: what service/product they asked about\n- last_topic: brief summary of main topic discussed (always include if any conversation happened)\n- email: if they mentioned an email\n- sentiment: \"positive\", \"neutral\", or \"negative\"\n\nRules:\n- ALWAYS extract a name if they introduced themselves\n- ALWAYS include last_topic if any conversation happened\n- ALWAYS include sentiment\n- Only omit keys where there is truly zero information\n- If no useful content, return {}\n\nReturn ONLY the JSON object. No explanation, no markdown, no backticks.",
              "role": "system"
            },
            {
              "content": "={{ 'SMS from: ' + $('Initialize Memory').first().json.sender + '\\n\\nUSER: ' + $('Initialize Memory').first().json.message + '\\n\\nASSISTANT: ' + $json.assistantReply }}"
            }
          ]
        },
