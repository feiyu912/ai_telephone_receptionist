    {
      "parameters": {
        "jsCode": "// Extract voice_id from query\nconst requestedId = $('Webhook: Voice Preview').first().json.query.voice_id;\n\n// Find matching voice\nconst allVoices = $input.all();\nconst matchedVoice = allVoices.find(item => item.json.voice_id === requestedId);\n\n// Use matched or fallback to first\nconst voiceInfo = matchedVoice ? matchedVoice.json : $input.first().json;\n\nconst pollyVoice = voiceInfo.polly_voice || \"Polly.Matthew-Neural\";\nconst displayName = voiceInfo.display_name || \"this voice\";\nconst tier = voiceInfo.tier || \"starter\";\n\nconst twiml = \\`\n<Response>\n    <Say voice=\"\\${pollyVoice}\">\n        Hi! I am \\${displayName}. This is a preview of my voice. How do I sound?\n    </Say>\n</Response>\n\\`;\n\nreturn [{ json: { twiml, voice_id: requestedId, tier: tier } }];"
      },
