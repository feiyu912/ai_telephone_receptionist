    },
    {
      "parameters": {
        "jsCode": "// Fallback to Polly TwiML\nconst text = $('Prepare Request').first().json.text;\nconst pollyVoice = $('Prepare Request').first().json.polly_fallback;\n\nreturn [{\n  json: {\n    fallback: true,\n    polly_voice: pollyVoice,\n    twiml: '<Say voice=\"' + pollyVoice + '\">' + text + '</Say>',\n    error: $json.error || 'Cartesia failed'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
