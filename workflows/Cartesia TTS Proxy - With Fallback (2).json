    },
    {
      "parameters": {
        "jsCode": "// Prepare request + fallback mapping\n// Map ElevenLabs voice IDs to Cartesia voice IDs and Polly fallbacks\nconst text = $json.query?.text || '';\nconst voiceId = $json.query?.voice_id || '21m00Tcm4TlvDq8ikWAM';\n\n// Cartesia voice mapping\n// Browse voices at: https://play.cartesia.ai/voices\nconst cartesiaVoiceMap = {\n  // ElevenLabs ID → Cartesia voice ID\n  '21m00Tcm4TlvDq8ikWAM': 'a0e99841-438c-4a64-b679-ae501e7d6091', // Rachel → similar warm female\n  'EXAVITQu4vr4xnSDUAt2': '79a125e8-cd45-4c13-8a67-188112f4dd22', // Sarah → similar professional female\n  'N2lVS1wzCLpS9S6w0XVv': 'ee7ea9f8-c0c1-4f7f-b220-2c5090ddd1af', // Joey → similar casual male\n  'pNlnz6obpgDQGcFmaJgB': 'c45bc5ec-dc68-4feb-8829-6e6b2748095d', // Adam → similar deep male\n  'Xb7hH9Td07v7vl8L9wK8': 'f9836c6e-a0bd-460e-9d3c-f7299fa60f94', // Ruth → similar warm female\n  'default': 'a0e99841-438c-4a64-b679-ae501e7d6091'\n};\n\nconst pollyFallback = {\n  '21m00Tcm4TlvDq8ikWAM': 'Polly.Matthew-Neural',\n  'EXAVITQu4vr4xnSDUAt2': 'Polly.Joanna-Neural',\n  'N2lVS1wzCLpS9S6w0XVv': 'Polly.Joey',\n  'pNlnz6obpgDQGcFmaJgB': 'Polly.Stephen',\n  'Xb7hH9Td07v7vl8L9wK8': 'Polly.Ruth',\n  'default': 'Polly.Matthew-Neural'\n};\n\nreturn [{\n  json: {\n    text: text,\n    original_voice_id: voiceId,\n    cartesia_voice_id: cartesiaVoiceMap[voiceId] || cartesiaVoiceMap['default'],\n    polly_fallback: pollyFallback[voiceId] || pollyFallback['default']\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -128
      ],
      "id": "a1e95f9f-8b80-4f7d-a1a3-d8309b096e2a",
      "name": "Prepare Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cartesia.ai/tts/bytes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $vars.CARTESIA_API_KEY }}"
            },
            {
              "name": "Cartesia-Version",
              "value": "2025-04-16"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model_id: 'sonic-3', transcript: $json.text, voice: { mode: 'id', id: $json.cartesia_voice_id }, language: 'en', output_format: { container: 'mp3', sample_rate: 24000, bit_rate: 128000 } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        416,
        -128
      ],
      "id": "865073bc-c622-4f25-b9d6-547218a1570c",
      "name": "Call Cartesia",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "success",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
